{
  "expo": {
    "name": "Humbug",
    "slug": "humbug",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "humbug",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "dev.lozt.humbug",
      "adaptiveIcon": {
        "backgroundColor": "#0B0B0F"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "dev.lozt.humbug"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-sqlite"
    ]
  }
}
